# Copier en .env :  cp .env.example .env
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000

ES_HOST=http://elasticsearch:9200
ES_VERSION=8.15.3
LOGSTASH_HTTP=http://logstash:8080

SPARK_MASTER=spark://spark-master:7077

# Kaggle (dump ArXiv) — https://www.kaggle.com/settings > API
KAGGLE_USERNAME=
KAGGLE_KEY=

# Limite de volume en dev (0 = pas de limite)
ARXIV_MAX_RECORDS=200000

# Source de citations : openalex | semantic_scholar
CITATIONS_SOURCE=openalex
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
